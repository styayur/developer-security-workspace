{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact-commit independent review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "pullRequest",
    "headSha",
    "baseSha",
    "workflowRunId",
    "verdict",
    "findings",
    "verification",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "pullRequest": {
      "type": "integer",
      "minimum": 1
    },
    "headSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "workflowRunId": {
      "type": "integer",
      "minimum": 1
    },
    "verdict": {
      "enum": [
        "APPROVE",
        "CHANGES_REQUIRED",
        "BLOCKED",
        "NOT_VERIFIED"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "line",
          "severity",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "conclusion",
          "headSha"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "conclusion": {
            "type": "string"
          },
          "headSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
