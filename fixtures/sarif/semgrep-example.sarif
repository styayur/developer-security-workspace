{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "version": "fixture-1.0",
          "rules": [
            {
              "id": "javascript.express.sql-injection",
              "name": "javascript.express.sql-injection",
              "shortDescription": {
                "text": "User input reaches a SQL query"
              },
              "fullDescription": {
                "text": "SQL is constructed from request data without parameterization."
              },
              "helpUri": "https://semgrep.dev/r/javascript.express.sql-injection",
              "properties": {
                "tags": [
                  "security",
                  "CWE-89"
                ],
                "security-severity": "8.8"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "javascript.express.sql-injection",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "User-controlled req.query.id is concatenated into a SQL query."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/api/user.ts"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 17,
                  "endLine": 8,
                  "endColumn": 55,
                  "snippet": {
                    "text": "const query = `SELECT * FROM users WHERE id = '${id}'`;"
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "fixture-semgrep-sql-v1"
          }
        }
      ]
    }
  ]
}